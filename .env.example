# Copy this file to .env and fill in your keys. .env is gitignored.

# Required: Google AI Studio / Gemini API key
GOOGLE_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2

# Not currently used by the app, but reserved for future web-search
# fallback features (see README).
TAVILY_API_KEY=

# Optional: override where the TinyDB JSON store lives (default: data/store_db.json)
# DB_PATH=data/store_db.json
